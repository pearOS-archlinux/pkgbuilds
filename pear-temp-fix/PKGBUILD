pkgname=pear-temp-fix
pkgver=26.8.1
pkgrel=1
pkgdesc="libprocesscore patcher, [cachyos] repository enabler and linux-firmware epoch realigner"
arch=('x86_64')
url="https://github.com/pearOS-archlinux/iso/"
license=('MIT')
depends=('cachyos-keyring')
install="${pkgname}.install"
source=('pear-firmware-realign' 'pear-firmware-realign.service')
sha256sums=('SKIP' 'SKIP')

package() {
    install -Dm755 "${srcdir}/pear-firmware-realign" "${pkgdir}/usr/bin/pear-firmware-realign"
    install -Dm644 "${srcdir}/pear-firmware-realign.service" \
        "${pkgdir}/usr/lib/systemd/system/pear-firmware-realign.service"
}
