#!/usr/bin/env bash
set -u

stamp=/var/lib/pear-temp-fix/firmware-realigned

refresh_mirrors() {
    command -v reflector >/dev/null 2>&1 || return 0
    echo "refreshing mirrorlist with reflector"
    reflector --save /etc/pacman.d/mirrorlist \
              --protocol https \
              --age 12 \
              --completion-percent 100 \
              --score 50 \
              --sort rate \
              --number 25 \
              --connection-timeout 5 \
              --download-timeout 5 || echo "reflector failed, keeping existing mirrorlist"
}

if [ -e "$stamp" ]; then
    exit 0
fi

if [ -e /var/lib/pacman/db.lck ]; then
    echo "pacman is busy, retrying on next boot"
    exit 0
fi

pkgs=()
while read -r name ver; do
    case "$ver" in
        *:*) pkgs+=("$name") ;;
    esac
done < <(pacman -Q 2>/dev/null | grep '^linux-firmware')

if [ "${#pkgs[@]}" -eq 0 ]; then
    install -d "$(dirname "$stamp")"
    : > "$stamp"
    refresh_mirrors
    echo "no epoch-versioned firmware packages, mirrors refreshed"
    exit 0
fi

refresh_mirrors

echo "realigning to the repository baseline: ${pkgs[*]}"

if ! pacman -Sy --noconfirm "${pkgs[@]}"; then
    echo "pacman failed, retrying on next boot"
    exit 1
fi

install -d "$(dirname "$stamp")"
: > "$stamp"
echo "done"
