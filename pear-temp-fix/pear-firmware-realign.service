[Unit]
Description=Refresh Arch mirrors and realign epoch-versioned linux-firmware packages
ConditionPathExists=!/var/lib/pear-temp-fix/firmware-realigned
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/pear-firmware-realign

[Install]
WantedBy=multi-user.target
