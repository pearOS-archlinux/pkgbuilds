# Maintainer: Alexandru Balan <alex@pear-software.com>
#
# zlib-ng in zlib-compat mode, repackaged byte for byte from the CachyOS repo.
#
# Why this lives in [pearos]: installs older than 26.11 have [cachyos] BELOW [extra] in
# /etc/pacman.conf. There, `pacman -Syu` takes zlib-ng-compat from [extra] (it has no
# "replaces"), which conflicts with zlib, and with --noconfirm pacman answers
# "Remove zlib? [y/N]" with N and aborts -- before any package script (pear-temp-fix, which
# moves [cachyos] above [core]) gets to run. [pearos] is always the first repo, so having the
# CachyOS build here makes pacman replace zlib cleanly (the same thing that happens on
# 26.11, where [cachyos] is already above [core]).
#
# Keep it equal to CachyOS's current version: while this package is here, [pearos] shadows
# [cachyos] for zlib-ng-compat, so it only updates when this PKGBUILD is bumped.
# (pkgver/pkgrel = the version of cachyos/zlib-ng-compat.)

pkgname=zlib-ng-compat
pkgver=2.3.3
pkgrel=2
pkgdesc="zlib replacement with optimizations for next generation systems (zlib-compat mode, CachyOS build)"
arch=('x86_64')
url="https://github.com/zlib-ng/zlib-ng"
license=('Zlib')
depends=('zlib-ng')
provides=('zlib' 'libz.so=1-64')
conflicts=('zlib')
replaces=('zlib')
options=('!strip' '!debug')
# saved under another name: the download would otherwise look like our own finished package
_src="cachyos-${pkgname}-${pkgver}-${pkgrel}.pkg.tar.zst"
source=("${_src}::https://mirror.cachyos.org/repo/x86_64/cachyos/${pkgname}-${pkgver}-${pkgrel}-x86_64.pkg.tar.zst")
noextract=("${_src}")
sha256sums=('SKIP')

package() {
    bsdtar -xf "${srcdir}/${_src}" -C "${pkgdir}" \
        --exclude='.BUILDINFO' --exclude='.MTREE' --exclude='.PKGINFO' --exclude='.INSTALL' --exclude='.CHANGELOG'
}
