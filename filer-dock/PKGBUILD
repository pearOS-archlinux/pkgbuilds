# Maintainer: pearOS

# Standalone Qt6/KF6 host for the pearos-dock Plasma applet, run outside
# plasmashell as its own always-on-top layer-shell panel -- spawned by Filer
# (a Qt5 app; the two can't be linked together) via
# Application::startDock()/stopDock() in src/application.cpp. See
# Filer/filer-dock/README.md for the full architecture writeup.
#
# To produce the source tarball:
#   cd Filer && tar -czf filer-dock-<pkgver>.tar.gz \
#       --transform 's,^filer-dock,filer-dock-<pkgver>,' \
#       filer-dock
#
# Installs the actual executable to /usr/lib/Filer.app/filer-dock (next to
# Filer itself, matching Application::startDock()'s lookup at
# applicationDirPath()+"/filer-dock" -- NOT /usr/bin, which that code never
# checks).
#
# Application::startDock() also unconditionally prepends
# $HOME/.local/lib/plugins to QT_PLUGIN_PATH, for the org.kde.panel
# containment plugin (filer-dock-panel-containment package, built from
# ../panel-containment-src) -- harmless once that package is installed
# system-wide: it lands at /usr/lib/qt6/plugins/plasma/applets (verified:
# CMAKE_INSTALL_PREFIX=/usr makes KDEInstallDirs auto-detect the shared Qt
# prefix and route plugins there), which Qt's QPluginLoader searches by
# default regardless of QT_PLUGIN_PATH.

pkgname=filer-dock
pkgver=26.7.24
pkgrel=1
pkgdesc="Standalone panel host for the pearos-dock Plasma applet, spawned by Filer without needing plasmashell"
arch=('x86_64')
url="https://github.com/pearOS-ArchLinux/Filer"
license=('GPL-2.0-or-later')
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-wayland'
    'kconfig'
    'libplasma'
    'layer-shell-qt'
    'pearos-dock'
    'plasma-workspace-components'
    'filer-dock-panel-containment'
    # For the org.pearos.shellshim QML module (see package()'s own comment
    # for why filer-dock's build needs filer-shell-common as a sibling
    # source directory but must NOT install its own copy of this module).
    'filer-topbar'
)
makedepends=(
    'cmake'
    'extra-cmake-modules'
    'gcc'
)
source=("$pkgname-$pkgver.tar.gz" 'filer-dock.desktop')
sha256sums=('07c882f0030764fd87d27950470c2ad82c2a236cc759048247fef44c035c4d75'
            'SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cmake -B build \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DFILER_DOCK_PEARDOCK_PACKAGE_DIR=/usr/share/plasma/plasmoids/PearDock
    make -C build -j$(nproc)
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    make -C build DESTDIR="$pkgdir" install

    # filer-dock's own CMakeLists.txt needs ../filer-shell-common as a real
    # sibling source directory (add_subdirectory) to build at all -- the
    # source tarball bundles a copy of it alongside filer-dock-$pkgver/ for
    # exactly that reason. But `make install` above installs its QML
    # plugin output (org.pearos.shellshim, the ecm_add_qml_module target)
    # to the same shared Qt path filer-topbar's own package already
    # installs it to (byte-identical content -- both build from the same
    # filer-shell-common source) -- confirmed live as a hard pacman file
    # conflict otherwise ("exists in both 'filer-topbar' and 'filer-dock'").
    # Only one package may own these files; filer-topbar already does, so
    # this package depends on it (see depends= above) instead of shipping
    # its own copy.
    rm -rf "$pkgdir/usr/lib/qt6/qml/org/pearos"

    # Application::startDock() looks next to Filer's own binary
    # (/usr/lib/Filer.app/, per soda-filer's PKGBUILD), not /usr/bin.
    install -dm755 "$pkgdir/usr/lib/Filer.app"
    mv "$pkgdir/usr/bin/filer-dock" "$pkgdir/usr/lib/Filer.app/filer-dock"
    rmdir --ignore-fail-on-non-empty "$pkgdir/usr/bin"

    # KWin only grants privileged Wayland protocols (here:
    # org_kde_plasma_window_management, needed for the dock to see any
    # windows/task icons at all) to clients matched against an installed
    # .desktop's Exec= path via X-KDE-Wayland-Interfaces -- without this,
    # filer-dock runs but silently shows no icons, denied by KWin ("The
    # PlasmaWindowManagement protocol hasn't activated in time").
    install -Dm644 "$srcdir/filer-dock.desktop" \
        "$pkgdir/usr/share/applications/org.pearos.filerdock.desktop"
}
