pkgname=soda-filer
pkgver=26.7.27
pkgrel=3
pkgdesc="Filer file manager and desktop for the Soda desktop environment (pearOS), with xdg-desktop-portal FileChooser backend"
arch=('x86_64')
url="https://github.com/pearOS-ArchLinux/Filer"
license=('GPL-2.0-or-later')
provides=('filer')
conflicts=('filer')
depends=(
    'qt5-base'
    'qt5-x11extras'
    'qt5-multimedia'
    'kwindowsystem5'
    'libfm'
    'menu-cache'
    'glib2'
    'libx11'
    'libxcb'
    'p7zip'              # zip extraction + Compress context-menu action
    'xdg-desktop-portal' # file chooser portal routing
    'soda-workspace'     # trimmed plasma-workspace fork (see pkgbuilds/soda-workspace); soda.desktop's session Exec is startplasma-wayland
    'aurorae'            # start-soda's default KWin decoration (org.kde.kwin.aurorae)
    'pearos-settings'    # ships the __aurorae__svg__pearOS-dark theme start-soda defaults to
)
makedepends=(
    'cmake'
    'gcc'
    'pkgconf'
    'qt5-tools'
)
optdepends=(
    'fastfetch: shows Soda as the desktop environment via the bundled config'
)
backup=(
    'etc/xdg/xdg-desktop-portal/kde-portals.conf'
    'etc/xdg/fastfetch/config.jsonc'
)
source=(
    "$pkgname-$pkgver.tar.gz"
    'filer.portal'
    'kde-portals.conf'
    'fastfetch-config.jsonc'
    'filer.desktop'
    'soda.desktop'
    'start-soda'
    'soda-workspace.target'
    'soda-workspace-wayland.target'
)
sha256sums=('c6e1be7aa901c76c178a8b29053112a859c604a356f8a0e4e1ba9fc7c9b17ba4'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cmake -B build \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_INSTALL_PREFIX=/usr/lib/Filer.app
    make -C build -j$(nproc)
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    # installs /usr/lib/Filer.app/{Filer,Resources/...}
    make -C build DESTDIR="$pkgdir" install

    # command-line launcher
    install -dm755 "$pkgdir/usr/bin"
    ln -s /usr/lib/Filer.app/Filer "$pkgdir/usr/bin/Filer"

    # xdg-desktop-portal: declare the "filer" FileChooser backend and
    # prefer it in KDE/Soda sessions. The preference goes to /etc/xdg
    # (checked before /usr/share) so it does not conflict with the
    # kde-portals.conf shipped by plasma.
    install -Dm644 "$srcdir/filer.portal" \
        "$pkgdir/usr/share/xdg-desktop-portal/portals/filer.portal"
    install -Dm644 "$srcdir/kde-portals.conf" \
        "$pkgdir/etc/xdg/xdg-desktop-portal/kde-portals.conf"
    install -Dm644 "$srcdir/kde-portals.conf" \
        "$pkgdir/etc/xdg/xdg-desktop-portal/soda-portals.conf"

    # fastfetch reports "Soda" as the DE (system-wide default config;
    # a per-user ~/.config/fastfetch/config.jsonc still wins)
    install -Dm644 "$srcdir/fastfetch-config.jsonc" \
        "$pkgdir/etc/xdg/fastfetch/config.jsonc"

    # app menu entry only -- NOT installed to /etc/xdg/autostart/ anymore
    # (filer-desktop-autostart.desktop's own Exec=Filer used to run
    # alongside start-soda's explicit `systemd-run ... Filer --desktop`,
    # both launching Filer at roughly the same time and racing for the
    # single-instance D-Bus name -- confirmed live: Filer aborted
    # (SIGABRT) during that race, and whichever process actually ended up
    # primary was whichever plain `Filer` (no --desktop) autostart handed
    # the name to, never entering desktop mode at all -- "dock and top bar
    # came up but no desktop icons/wallpaper". start-soda starting Filer
    # itself (see its own header comment) was always meant to replace this
    # entry, not run alongside it.
    install -Dm644 "$srcdir/filer.desktop" \
        "$pkgdir/usr/share/applications/filer.desktop"

    install -Dm644 src/icons/filer-128.png \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/filer.png"

    # SDDM/greeter session entry: shows up as "Soda" in the login screen's
    # session picker instead of plasma-workspace's own "Plasma (Wayland)".
    # This is a second, separately-named session choice alongside
    # plasma.desktop, not a replacement for it.
    install -Dm644 "$srcdir/soda.desktop" \
        "$pkgdir/usr/share/wayland-sessions/soda.desktop"
    # soda.desktop's own Exec= -- see start-soda's own doc comment for why
    # this exists instead of pointing at startplasma-wayland directly.
    install -Dm755 "$srcdir/start-soda" \
        "$pkgdir/usr/bin/start-soda"

    # soda-workspace(-wayland).target: Soda's own trimmed stand-in for
    # plasma-workspace(-wayland).target, used by start-soda instead of the
    # real Plasma ones. Keeps kwin_wayland/kded6/ksmserver (via
    # plasma-core.target) plus powerdevil/polkit-agent/kwallet-pam/
    # kglobalaccel/gmenudbusmenuproxy/xdg-desktop-autostart.target, drops
    # xembedsniproxy/kde-baloo/kactivitymanagerd/restoresession/kaccess/
    # foreground-booster/startupsound -- none of which Soda uses.
    install -Dm644 "$srcdir/soda-workspace.target" \
        "$pkgdir/usr/lib/systemd/user/soda-workspace.target"
    install -Dm644 "$srcdir/soda-workspace-wayland.target" \
        "$pkgdir/usr/lib/systemd/user/soda-workspace-wayland.target"

    # Mask specific autostart/session services xdg-desktop-autostart.target
    # and plasma-core.target would otherwise still pull in (PIM/Akonadi,
    # KDE Connect, geoclue demo agent, print applet, xapp status-notifier
    # watcher, activity manager) -- none of these are wanted by Soda, and
    # masking system-wide (not per-user) means a fresh user account gets
    # the same trimmed session without needing to run `systemctl mask`
    # themselves.
    local _mask_unit
    for _mask_unit in \
        akonadi_control.service \
        plasma-kactivitymanagerd.service \
        kde-baloo.service \
        'app-org.kde.kalendarac@autostart.service' \
        'app-org.kde.kdeconnect.daemon@autostart.service' \
        'app-geoclue\x2ddemo\x2dagent@autostart.service' \
        'app-print\x2dapplet@autostart.service' \
        'app-xapp\x2dsn\x2dwatcher@autostart.service' \
        'app-msm_kde_notifier@autostart.service'
    do
        install -dm755 "$pkgdir/etc/systemd/user"
        ln -sf /dev/null "$pkgdir/etc/systemd/user/$_mask_unit"
    done
}
