#!/bin/sh
# All of these must be BOTH exported here AND sent via set-environment.
# startplasma-wayland (started below with `&`, inheriting this shell's own
# environment) calls dropSessionVarsFromSystemdEnvironment() internally
# (startkde/startplasma.cpp) as part of its own startup: for every
# "session variable" (DISPLAY, XAUTHORITY, WAYLAND_DISPLAY,
# WAYLAND_SOCKET, and anything starting with XDG_ -- see
# isSessionVariable() there) that ISN'T present in ITS OWN process
# environment, it explicitly calls UnsetEnvironment on the systemd user
# manager to remove it. Confirmed live: XDG_CURRENT_DESKTOP, DISPLAY,
# XAUTHORITY and WAYLAND_DISPLAY were all correctly set-environment'd
# below, then silently wiped a moment later by exactly this, leaving
# ksmserver/kglobalaccel/spectacle's permission check etc back to
# fighting over a session with no DISPLAY at all -- while
# XDG_MENU_PREFIX/XDG_CONFIG_DIRS survived, because those happened to
# already be exported here too.
export XDG_CURRENT_DESKTOP="Soda:KDE"
export XDG_MENU_PREFIX="plasma-"
export XDG_CONFIG_DIRS="$HOME/.config/kdedefaults:/etc/xdg"
systemctl --user set-environment XDG_CURRENT_DESKTOP="$XDG_CURRENT_DESKTOP"
systemctl --user set-environment XDG_MENU_PREFIX="$XDG_MENU_PREFIX"
systemctl --user set-environment XDG_CONFIG_DIRS="$XDG_CONFIG_DIRS"
systemctl --user set-environment QT_QPA_PLATFORMTHEME=kde
export QT_QPA_PLATFORM=wayland
systemctl --user set-environment QT_QPA_PLATFORM=wayland

log="$XDG_RUNTIME_DIR/soda-startup.log"
: > "$log"
echo "[$(date +%T)] starting kwin" >> "$log"
systemctl --user start plasma-kwin_wayland.service 2>/dev/null

wayland_socket=""
for i in $(seq 1 300); do
    wayland_socket=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-[0-9]*' -printf '%f\n' 2>/dev/null | head -1)
    [ -n "$wayland_socket" ] && break
    sleep 0.1
done
echo "[$(date +%T)] wayland_socket=[$wayland_socket] after ${i}x0.1s" >> "$log"
if [ -n "$wayland_socket" ]; then
    export WAYLAND_DISPLAY="$wayland_socket"
    systemctl --user set-environment WAYLAND_DISPLAY="$wayland_socket"
fi

# kwin_wayland can re-exec itself partway through startup (a wrapper/early
# instance without --xwayland-* yet, then the real one with it) -- waiting
# only for *a* kwin_wayland process to exist isn't enough, confirmed live:
# the loop caught an early PID whose cmdline had no --xwayland-display/
# --xwayland-xauthority yet, came away with nothing, and never retried.
# ksmserver hardcodes QT_QPA_PLATFORM=xcb itself (ksmserver/main.cpp,
# "ksmserver is very X11 specific") and needs a real XWayland DISPLAY/
# XAUTHORITY to connect to -- without them it aborts on
# QGuiApplication's own construction, immediately, every time. So retry
# until the values are actually extracted, not just until some PID exists.
xwayland_display=""
xwayland_authority=""
for i in $(seq 1 300); do
    kwin_pid=$(pgrep -x kwin_wayland | head -1)
    if [ -n "$kwin_pid" ] && [ -r "/proc/$kwin_pid/cmdline" ]; then
        kwin_args=$(tr '\0' '\n' < "/proc/$kwin_pid/cmdline")
        xwayland_display=$(printf '%s\n' "$kwin_args" | grep -A1 -x -- '--xwayland-display' | tail -1)
        xwayland_authority=$(printf '%s\n' "$kwin_args" | grep -A1 -x -- '--xwayland-xauthority' | tail -1)
        # The flags being present in kwin's own cmdline only means kwin
        # INTENDS to run XWayland on that display -- XWayland is a
        # separate process kwin spawns and it can take a bit longer to
        # actually come up and start listening. Confirmed live: extracting
        # non-empty display/authority strings here was NOT enough either,
        # ksmserver still got "could not connect to display" -- wait for
        # the real X11 socket to exist too.
        if [ -n "$xwayland_display" ] && [ -n "$xwayland_authority" ] \
           && [ -S "/tmp/.X11-unix/X${xwayland_display#:}" ]; then
            break
        fi
    fi
    sleep 0.1
done
echo "[$(date +%T)] xwayland_display=[$xwayland_display] xwayland_authority=[$xwayland_authority] after ${i}x0.1s" >> "$log"
if [ -n "$xwayland_display" ]; then
    export DISPLAY="$xwayland_display"
    systemctl --user set-environment DISPLAY="$xwayland_display"
fi
if [ -n "$xwayland_authority" ]; then
    export XAUTHORITY="$xwayland_authority"
    systemctl --user set-environment XAUTHORITY="$xwayland_authority"
fi

# WAYLAND_DISPLAY/DISPLAY/XAUTHORITY are now in the manager's environment
# BEFORE anything else starts -- kglobalaccel/gmenudbusmenuproxy/etc, all
# pulled in below via soda-workspace-wayland.target, used to race this and
# fall back to a nonexistent X11/xcb (confirmed live: kglobalacceld
# crashing with "Could not load the Qt platform plugin xcb", then Filer
# itself crashing the same way with nothing to restart it -- black screen).
/usr/bin/startplasma-wayland &
session_pid=$!
systemctl --user start soda-workspace-wayland.target 2>/dev/null

systemctl --user restart plasma-ksmserver.service 2>/dev/null

kbuildsycoca6 --noincremental 2>/dev/null

if [ -z "$(kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key library 2>/dev/null)" ]; then
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library "org.kde.kwin.aurorae"
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme "__aurorae__svg__pearOS-dark"
fi

if [ -z "$(kreadconfig6 --file kdeglobals --group "Icon Theme" --key Theme 2>/dev/null)" ]; then
    kwriteconfig6 --file kdeglobals --group "Icon Theme" --key Theme "pearOS-blue-dark"
fi

for _ in $(seq 1 50); do
    qdbus6 org.kde.KWin /KWin supportInformation >/dev/null 2>&1 && break
    sleep 0.1
done
qdbus6 org.kde.KWin /KWin reconfigure 2>/dev/null

systemd-run --user --scope --slice=session.slice --unit=soda-filer-desktop -- Filer --desktop &

for delay in 5 10 15 20 25 30 40 50 65 80 100 120 180 300; do
    (
        sleep "$delay"
        {
            echo "[$(date +%T)] delay=${delay}s DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
            out=$(kbuildsycoca6 --noincremental 2>&1); echo "[$(date +%T)] kbuildsycoca6 rc=$? out=$out"
            out=$(qdbus6 org.kde.KWin /KWin reconfigure 2>&1); echo "[$(date +%T)] KWin reconfigure rc=$? out=$out"
        } >> "$XDG_RUNTIME_DIR/soda-icon-kick.log" 2>&1
    ) &
done

wait "$session_pid"
