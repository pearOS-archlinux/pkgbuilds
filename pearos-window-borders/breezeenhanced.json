{
    "KPlugin": {
        "Description": "pearOS-style window decoration for the Plasma Desktop",
        "EnabledByDefault": true,
        "Id": "org.kde.pearos_enhanced",
        "Name": "pearOS",
        "ServiceTypes": [
            "org.kde.kdecoration2",
            "org.kde.kdecoration3"
        ]
    },
    "X-KDE-ConfigModule": "kcm_pearos",
    "org.kde.kdecoration2": {
        "blur": true,
        "recommendedBorderSize": "None"
    },
    "org.kde.kdecoration3": {
        "blur": true,
        "recommendedBorderSize": "None"
    }
}
