pkgname=pearos-appstore
pkgver=26.5.0
pkgrel=2
pkgdesc="pearOS AppStore - modern Qt6 app store for Arch-based systems"
arch=('x86_64')
url="https://pearos.xyz"
license=('MIT')
depends=('qt6-base' 'pacman')
makedepends=('cmake' 'qt6-base' 'pkgconf')
source=()
sha256sums=()

build() {
  # Build out-of-tree so packaging never touches the source tree.
  # Source (CMakeLists.txt, src/) lives directly in startdir.
  local srcroot="${startdir}"

  mkdir -p "${startdir}/cmake-pkg"
  cd "${startdir}/cmake-pkg"

  cmake "${srcroot}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr

  cmake --build . -- -j"$(nproc)"
}

package() {
  cd "${startdir}/cmake-pkg"
  make DESTDIR="${pkgdir}" install
}

